#nop ============================================================
#nop DSL / Dark and Shattered Lands TinTin++ profile
#nop Start with: tt++ ~/.tintin/dsl.tin
#nop ============================================================

#nop --- Keep typed commands visible while game output scrolls
#SPLIT 0 1

#nop --- Logging
#LOG timestamp {%Y-%m-%d %H:%M:%S}
#LOG append {~/.tintin/logs/dsl.log}

#nop --- Connect
#SESSION {dsl} {dsl-mud.org} {4000}

#nop ============================================================
#nop Aliases
#nop ============================================================

#ALIAS {d}
{
    down
}

#ALIAS {detect}
{
    cast 'detect magic';
    cast 'detect invis'
}

#ALIAS {e}
{
    east
}

#ALIAS {eq}
{
    equipment
}

#ALIAS {i}
{
    inventory
}

#ALIAS {l}
{
    look
}

#ALIAS {n}
{
    north
}

#ALIAS {ne}
{
    northeast
}

#ALIAS {nw}
{
    northwest
}

#ALIAS {q}
{
    quit
}

#ALIAS {re}
{
    rest
}

#ALIAS {run1}
{
    d;
    se;
    e;
    e;
    e;
    n;
    e;
    e;
    e;
    e;
    open east;
    e;
    e;
    s
}

#ALIAS {run1slow}
{
    d;
    #DELAY {0.2} {se};
    #DELAY {0.4} {e};
    #DELAY {0.6} {e};
    #DELAY {0.8} {e};
    #DELAY {1.0} {n};
    #DELAY {1.2} {e};
    #DELAY {1.4} {e};
    #DELAY {1.6} {e};
    #DELAY {1.8} {e};
    #DELAY {2.0} {open east};
    #DELAY {2.2} {e};
    #DELAY {2.4} {e};
    #DELAY {2.6} {s}
}

#ALIAS {run2slow}
{
    d;
    #DELAY {0.5} {southeast};
    #DELAY {1.0} {e};
    #DELAY {1.5} {s};
    #DELAY {2.0} {s};
    #DELAY {2.5} {s};
    #DELAY {3.0} {w};
    #DELAY {3.5} {w};
    #DELAY {4.0} {w};
    #DELAY {4.5} {n};
    #DELAY {5.0} {n};
    #DELAY {5.5} {n};
    #DELAY {6.0} {n};
    #DELAY {6.5} {n};
    #DELAY {7.0} {n};
    #DELAY {7.5} {e};
    #DELAY {8.0} {e};
    #DELAY {8.5} {n};
    #DELAY {9.0} {w};
    #DELAY {9.5} {u}
}

#ALIAS {s}
{
    south
}

#ALIAS {sc}
{
    score
}

#ALIAS {se}
{
    southeast
}

#ALIAS {st}
{
    stand
}

#ALIAS {sw}
{
    southwest
}

#ALIAS {u}
{
    up
}

#ALIAS {w}
{
    west
}

#ALIAS {levelup}
{
    enter alth;
    w;
    s;
    s;
    sw;
    w;
    sw;
    w;
    w;
    w;
    n;
    n;
    w;
    w;
    n;
    n;
    n;
    e;
    s;
    e;
    e;
    e;
    e;
    e;
    e;
    n;
    n;
    w;
    w;
    s;
    d
}

#ALIAS {levelupslow}
{
    enter alth;
    #DELAY {0.5} {w};
    #DELAY {1.0} {s};
    #DELAY {1.5} {s};
    #DELAY {2.0} {sw};
    #DELAY {2.5} {w};
    #DELAY {3.0} {sw};
    #DELAY {3.5} {w};
    #DELAY {4.0} {w};
    #DELAY {4.5} {w};
    #DELAY {5.0} {n};
    #DELAY {5.5} {n};
    #DELAY {6.0} {w};
    #DELAY {6.5} {w};
    #DELAY {7.0} {n};
    #DELAY {7.5} {n};
    #DELAY {8.0} {n};
    #DELAY {8.5} {e};
    #DELAY {9.0} {s};
    #DELAY {9.5} {e};
    #DELAY {10.0} {e};
    #DELAY {10.5} {e};
    #DELAY {11.0} {e};
    #DELAY {11.5} {e};
    #DELAY {12.0} {e};
    #DELAY {12.5} {n};
    #DELAY {13.0} {n};
    #DELAY {13.5} {w};
    #DELAY {14.0} {w};
    #DELAY {14.5} {s};
    #DELAY {15.0} {d}
}

#nop ============================================================
#nop Config
#nop ============================================================

#CONFIG {BUFFER SIZE} {100000}
#CONFIG {CHARSET} {UTF-8}
#CONFIG {COLOR MODE} {256}
#CONFIG {COLOR PATCH} {OFF}
#CONFIG {COMMAND COLOR} {\e[0;37m}
#CONFIG {COMMAND ECHO} {OFF}
#CONFIG {COMPACT} {OFF}
#CONFIG {HISTORY SIZE} {1000}
#CONFIG {LOG MODE} {RAW}
#CONFIG {MOUSE} {OFF}
#CONFIG {PACKET PATCH} {AUTO OFF}
#CONFIG {REPEAT CHAR} {!}
#CONFIG {REPEAT ENTER} {OFF}
#CONFIG {SCREEN READER} {OFF}
#CONFIG {SCROLL LOCK} {ON}
#CONFIG {SPEEDWALK} {ON}
#CONFIG {TELNET} {ON}
#CONFIG {VERBATIM} {OFF}
#CONFIG {VERBATIM CHAR} {\}
#CONFIG {VERBOSE} {OFF}
#CONFIG {WORDWRAP} {ON}

#nop ============================================================
#nop Path directions
#nop ============================================================

#PATHDIR {d} {u} {32}
#PATHDIR {e} {w} {2}
#PATHDIR {n} {s} {1}
#PATHDIR {ne} {sw} {3}
#PATHDIR {nw} {se} {9}
#PATHDIR {s} {n} {4}
#PATHDIR {se} {nw} {6}
#PATHDIR {sw} {ne} {12}
#PATHDIR {u} {d} {16}
#PATHDIR {w} {e} {8}
